#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT=$(git rev-parse --show-toplevel)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

UNENCRYPTED_LIST=""

for file in $STAGED_FILES; do
    # Check for unencrypted tfvars or jwk files (must contain .sops.)
    if [[ "$file" =~ \.(tfvars|jwk)$ ]] && [[ ! "$file" =~ \.sops\. ]]; then
        UNENCRYPTED_LIST+="$file\n"
    fi

    # Check for plaintext Kubernetes Secrets inside gitops/
    if [[ "$file" =~ ^gitops/.*\.yaml$ ]] && [[ ! "$file" =~ \.sops\.yaml$ ]]; then
        if [ -f "$PROJECT_ROOT/$file" ] && grep -qE "^kind:\s*Secret" "$PROJECT_ROOT/$file" 2>/dev/null; then
            UNENCRYPTED_LIST+="$file\n"
        fi
    fi
done

if [ -n "$UNENCRYPTED_LIST" ]; then
    echo -e "\033[0;31mERROR: Commit blocked! Unencrypted secrets detected.\033[0m"
    echo -e "\033[1;33mConvention:\033[0m All secrets must be encrypted and follow the \033[1;32m*.sops.*\033[0m naming convention."
    echo ""
    echo "The following files violate this rule:"
    echo -e "$UNENCRYPTED_LIST" | sed '/^$/d' | sed 's/^/  - /'
    echo ""
    echo "Solution:"
    echo "Encrypt the file(s) using SOPS and stage the encrypted version:"
    echo -e "\033[0;36m  sops --encrypt --in-place <file>\n  git add <file>\033[0m"
    echo ""
    echo "After encrypting, simply execute your commit again."
    exit 1
fi

exit 0
