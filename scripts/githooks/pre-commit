#!/bin/bash

PROJECT_ROOT=$(git rev-parse --show-toplevel)
CONFIG_PATH="$PROJECT_ROOT/.sops.yaml"

# Encrypt specific file types based on directory and extension
encrypt_files() {
    local rel_dir=$1
    local extension=$2
    local sops_type=$3

    if [ ! -d "$PROJECT_ROOT/$rel_dir" ]; then
        echo "Info: Directory $rel_dir does not exist. Skipping..."
        return
    fi

    while read -r file; do
        target_file="$file.enc"
        filename=$(basename "$file")

        # Skip empty files
        if [ ! -s "$file" ]; then
            echo "ERROR: Skipping empty file $filename."
            exit 1
        fi

        # Skip if encrypted file is newer than source file
        if [ -f "$target_file" ] && [ "$file" -ot "$target_file" ]; then
            continue
        fi

        echo "Encrypting file: $rel_dir/$filename (Type: $sops_type)"

        if sops --encrypt \
             --config "$CONFIG_PATH" \
             --input-type "$sops_type" \
             --output-type "$sops_type" \
             --output "$target_file" \
             "$file"; then
            git add "$target_file"
        else
            echo "ERROR: Encryption failed for $filename. Check your .sops.yaml!"
            exit 1
        fi
    done < <(find "$PROJECT_ROOT/$rel_dir" -type f -name "*.$extension")
}

# Scan the gitops directory for Kubernetes Secrets and encrypt them dynamically
encrypt_gitops_secrets() {
    local rel_dir="gitops"

    if [ ! -d "$PROJECT_ROOT/$rel_dir" ]; then
        return
    fi

    while read -r file; do
        # Check if the file content defines a Kubernetes Secret
        if grep -qE "^kind:\s*Secret" "$file"; then
            local ext="${file##*.}"
            local base="${file%.*}"
            local target_file="${base}.sops.${ext}"
            local filename=$(basename "$file")

            # Skip empty files
            if [ ! -s "$file" ]; then
                echo "ERROR: Skipping empty file $filename."
                exit 1
            fi

            # Skip if encrypted file is newer than source file
            if [ -f "$target_file" ] && [ "$file" -ot "$target_file" ]; then
                continue
            fi

            echo "Encrypting: $filename -> $(basename "$target_file")"

            if sops --encrypt \
                 --config "$CONFIG_PATH" \
                 --input-type yaml \
                 --output-type yaml \
                 --output "$target_file" \
                 "$file"; then
                git add "$target_file"

                if [ -f "$file" ]; then
                    rm -f "$file"
                    echo "INFO: Removed local plaintext file: $filename"
                fi
            else
                echo "ERROR: SOPS encryption failed for $filename. Check your .sops.yaml!"
                exit 1
            fi
        fi
    done < <(find "$PROJECT_ROOT/$rel_dir" -type f \( -name "*.yml" -o -name "*.yaml" \) ! -name "*.sops.y*ml")
}

# Run encryption routines
echo "Encrypting opentofu, tfvars and dotenv..."
encrypt_files "opentofu" "tfvars" "dotenv"
echo "Done!"

echo "Encrypting tang keys..."
encrypt_files "ansible/roles/tang/files/tang-keys" "jwk" "json"
echo "Done!"

echo "Encrypting k8s secrets inside gitops/"
encrypt_gitops_secrets
echo "Done!"

echo "Now starting security check for unencrypted secrets..."

SECURITY_FAILED=0

# Check for staged but unencrypted tfvars and jwk files
UNENCRYPTED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E "\.(tfvars|jwk)$" | grep -v "\.enc$")
if [ -n "$UNENCRYPTED_FILES" ]; then
    echo "Unencrypted tfvars/jwk found:"
    echo "$UNENCRYPTED_FILES"
    SECURITY_FAILED=1
fi

# Check for staged plaintext Kubernetes Secrets in the gitops directory
STAGED_YAMLS=$(git diff --cached --name-only --diff-filter=d | grep -E "^gitops/.*\.(yml|yaml)$" | grep -v "\.sops\.")
for f in $STAGED_YAMLS; do
    if grep -qE "^kind:\s*Secret" "$PROJECT_ROOT/$f"; then
        echo "Plaintext Kubernetes Secret found in staging: $f"
        SECURITY_FAILED=1
    fi
done

# Block the commit if any plaintext secrets are in the staging area
if [ $SECURITY_FAILED -eq 1 ]; then
    echo "######################################################################"
    echo "ATTENTION: SECURITY RISK DETECTED!"
    echo "Committing plaintext secrets is NOT permitted."
    echo "Please remove them with: git restore --staged <file>"
    echo "######################################################################"
    exit 1
else
    echo "Check passed: No unencrypted secrets found."
fi

exit 0
