apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cluster1-root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: "{{ github_repo_url }}"
    targetRevision: main
    path: gitops/config/cluster1
  destination:
    server: 'https://kubernetes.default.svc'
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
