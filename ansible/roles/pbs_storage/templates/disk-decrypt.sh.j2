#!/bin/bash
# Generated by Ansible
set -e

DEVICE="{{ vault_disk_device }}"
MAPPER_NAME="{{ vault_mapper_name }}"
POOL_NAME="{{ vault_pool_name }}"
TANG_SERVER="{{ vault_tang_url | urlsplit('hostname') }}"
EMAIL="{{ vault_admin_email | default('root@localhost') }}"

send_error_email() {
  local subject="Disk-Decrypt Error on $(hostname)"
  journalctl -u disk-decrypt.service -n 50 | mail -s "$subject" "$EMAIL"
}

echo "<6>Starting disk decryption process..."

systemctl restart systemd-resolved || true

if ! curl -sfg "https://$TANG_SERVER/adv" &>/dev/null; then
  echo "<3>ERROR: Tang advertisements at $TANG_SERVER/adv unreachable or invalid!"
  send_error_email
  exit 1
fi

if [ ! -b "/dev/mapper/$MAPPER_NAME" ]; then
    echo "<6>Decrypting $DEVICE..."
    if ! clevis luks unlock -d "$DEVICE" -n "$MAPPER_NAME"; then
      echo "<3>ERROR: Decryption failed!"
      send_error_email
      exit 1
    fi
else
    echo "<5>Device already decrypted (Mapper $MAPPER_NAME active)."
fi

if ! zpool list "$POOL_NAME" &>/dev/null; then
    echo "<6>Importing ZFS Pool $POOL_NAME..."
    if ! zpool import -d /dev/mapper "$POOL_NAME"; then
      echo "<3>ERROR: Failed to import ZFS pool $POOL_NAME"
      send_error_email
      exit 1
    fi
fi

systemctl start proxmox-backup.service proxmox-backup-proxy.service

echo "<5>Unlock and Import successful."
