#!/bin/bash
# Dynamically generated by Ansible
set -e

LOGFILE="/var/log/disk-decrypt.log"
exec > >(ts '[%Y-%m-%d %H:%M:%S]' | tee -a "$LOGFILE") 2>&1

DEVICE="{{ vault_disk_device }}"
MAPPER_NAME="{{ vault_mapper_name }}"
POOL_NAME="{{ vault_pool_name }}"
TANG_SERVER="{{ vault_tang_url | urlsplit('hostname') }}"
EMAIL="{{ vault_admin_email | default('root@localhost') }}"

send_error_email() {
  local subject="Disk-Decrypt Error on $(hostname)"
  mail -s "$subject" "$EMAIL" < "$LOGFILE"
}

ansible.builtin.systemctl restart systemd-resolved || true

# Assuming wireguard connection already established with Ansible wireguard playbook
if ! ping -c1 -W2 "$TANG_SERVER" &>/dev/null; then
  echo "ERROR: Tang server $TANG_SERVER unreachable!"
  send_error_email
  exit 1
fi

if [ ! -b "/dev/mapper/$MAPPER_NAME" ]; then
    echo "Decrypting $DEVICE..."
    if ! clevis luks unlock -d "$DEVICE" -n "$MAPPER_NAME"; then
      echo "ERROR: Decryption failed!"
      send_error_email
      exit 1
    fi
else
    echo "Device already decrypted (Mapper $MAPPER_NAME active)."
fi

if ! zpool list "$POOL_NAME" &>/dev/null; then
    echo "Importing ZFS Pool $POOL_NAME..."
    if ! zpool import -d /dev/mapper "$POOL_NAME"; then
      echo "ERROR: Failed to import ZFS pool $POOL_NAME"
      send_error_email
      exit 1
    fi
fi

systemctl start proxmox-backup.service proxmox-backup-proxy.service

echo "Unlock and Import successful."
