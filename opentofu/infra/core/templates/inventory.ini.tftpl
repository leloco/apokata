# ----------------------- WARNING -------------------------
# THIS FILE IS AUTOGENERATED BY OPENTOFU (/opentofu/infra/core/main.tf)
# Any manual changes to this file will be overwritten during the next run of tofu apply.
# Generated on: ${timestamp()}
# ---------------------------------------------------------

# ==================== HOST DEFINITIONS ====================
%{ for name, h in active_hosts ~}
${h.host_entry}
%{ endfor ~}

# ==================== DYNAMIC GROUPS WITH HOST REFERENCES ====================
%{ for group, hosts in grouped_hosts ~}
%{ if length(hosts) > 0 ~}
[${group}]
%{ for h in hosts ~}
${h.hostname}
%{ endfor ~}

%{ endif ~}
%{ endfor ~}

# ==================== STATIC GROUPS & VARS ====================

%{ if is_prod ~}
[cloudflare_r2_backups]
localhost ansible_connection=local

[cloudflare_r2_backups:vars]
r2_endpoint=https://${cloudflare_account_id}.r2.cloudflarestorage.com
r2_bucket_opnsense=${r2_opnsense}
r2_bucket_truenas=${r2_truenas}
r2_bucket_unifi=${r2_unifi}
%{ endif ~}

[all:children]
%{ for group, hosts in grouped_hosts ~}
%{ if length(hosts) > 0 ~}
${group}
%{ endif ~}
%{ endfor ~}

[all:vars]
dns_gateway_ipv4=${dns_gateway_ipv4}
dns_gateway_ipv6=${dns_gateway_ipv6}
custom_domain=x3dh.de
virtual_ipv4=${virtual_ipv4}
virtual_ipv6=${virtual_ipv6}
# ansible settings
ansible_user=root
# configured with ssh-agent
ansible_ssh_trusted_key_file=""
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
# environment settings
env=${is_prod ? "prod" : "staging"}
