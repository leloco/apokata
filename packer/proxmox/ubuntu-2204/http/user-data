#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu-base
    username: ubuntu
    # ubuntu
    password: "$6$rounds=4096$rounds=4096$1V9XqW4x0rC8P4M6$w91yqX8zO8b/5I8kF.dG8iYhW3o6k2V4tL6j9yX0rC8P4M6w91yqX8zO8b/5I8kF.dG8iYhW3o6k2V4tL6"
  ssh:
    install-server: true
    authorized-keys:
      - ssh-rsa  leoneifler@proton.me
    allow-pw: false
  packages:
    - qemu-guest-agent
    - sudo
  storage:
    layout:
      name: lvm
  network:
    network:
      version: 2
      ethernets:
        ens18:
          dhcp4: true
  late-commands:
    - curtin in-target --target=/target -- systemctl enable qemu-guest-agent
    - echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/ubuntu
    - chmod 440 /target/etc/sudoers.d/ubuntu
